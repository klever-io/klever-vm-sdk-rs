        "address:alice": {
          "nonce": "*",
          "balance": "999,000",
          "storage": {}
        },
        "address:bob": {
          "nonce": "*",
          "balance": "999,000",
          "storage": {}
        },
        "address:carol": {
          "nonce": "*",
          "balance": "1,000,000",

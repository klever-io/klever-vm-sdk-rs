      "step": "externalSteps",
      "path": "commit-and-reveal-on-time.scen.json"
    },
    {
      "step": "scCall",
      "id": "carol-finalize-round-1-again",
      "tx": {
        "from": "address:carol",
        "to": "sc:commit-reveal",
        "function": "finalize",
        "arguments": [
          "1"

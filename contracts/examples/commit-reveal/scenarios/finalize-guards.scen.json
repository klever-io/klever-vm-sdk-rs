    {
      "step": "scCall",
      "id": "owner-claim-nothing",
      "tx": {
        "from": "address:owner",
        "to": "sc:commit-reveal",
        "function": "claim",
        "arguments": [],
        "gasLimit": "100,000,000",
        "gasPrice": "0"
